{
  "manifest_version": 3,
  "name": "wudict Hover",
  "version": "0.0.0",
  "description": "Show wudict dictionary definitions on hover, optionally behind a modifier key.",
  "minimum_chrome_version": "116",
  "background": {
    "service_worker": "background/main.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "action": {
    "default_title": "wudict Hover",
    "default_popup": "action/action.html",
    "default_icon": {
      "16": "icons/on-16.png",
      "32": "icons/on-32.png",
      "48": "icons/on-48.png",
      "128": "icons/on-128.png"
    }
  },
  "icons": {
    "16": "icons/on-16.png",
    "32": "icons/on-32.png",
    "48": "icons/on-48.png",
    "128": "icons/on-128.png"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Alt+W" },
      "description": "Open the wudict Hover panel"
    },
    "lookup-selection": {
      "suggested_key": { "default": "Alt+Shift+W" },
      "description": "Look up the selected text in wudict"
    },
    "toggle-enabled": {
      "description": "Pause or resume hover lookup everywhere"
    },
    "toggle-site": {
      "description": "Pause or resume hover lookup on this site"
    }
  },
  "permissions": ["storage", "contextMenus"],
  "host_permissions": ["http://127.0.0.1:6888/*"],
  "optional_host_permissions": ["http://*/*", "https://*/*"]
}
