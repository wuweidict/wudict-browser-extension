{
  "manifest_version": 3,
  "name": "wudict Hover",
  "version": "0.0.0",
  "description": "Show wudict dictionary definitions on hover, optionally behind a modifier key.",
  "minimum_chrome_version": "116",
  "background": {
    "service_worker": "background/main.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "action": {
    "default_title": "wudict Hover — options"
  },
  "permissions": ["storage"],
  "host_permissions": ["http://127.0.0.1:6888/*"],
  "optional_host_permissions": ["http://*/*", "https://*/*"]
}
